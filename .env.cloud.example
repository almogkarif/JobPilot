# JobPilot Cloud — multi-user server values. Never expose the Supabase Secret key to the browser.
JOBPILOT_AUTH_MODE=supabase

# Up to ~10 accounts. For a private group, list every allowed login email.
JOBPILOT_MAX_USERS=10
JOBPILOT_ALLOWED_EMAILS=you@example.com,friend1@example.com,friend2@example.com
# Optional: this account is marked admin. If omitted, the first admitted account becomes admin.
JOBPILOT_OWNER_EMAIL=you@example.com
# Beta: only this account can pair/run the application-submission Agent.
JOBPILOT_APPLICATION_AGENT_OWNER_EMAIL=your-email@example.com
JOBPILOT_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_RANDOM_SECRET

# Supabase Auth / Storage
JOBPILOT_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
JOBPILOT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
JOBPILOT_SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SB_SECRET_KEY
# Legacy projects may instead set JOBPILOT_SUPABASE_SERVICE_ROLE_KEY to the service_role JWT.
JOBPILOT_SUPABASE_STORAGE_BUCKET=jobpilot-private
JOBPILOT_STORAGE_MODE=supabase

# Supabase Postgres Session Pooler URL. SQLAlchemy converts postgresql:// to psycopg3 automatically.
JOBPILOT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

# Public URL of the deployed JobPilot server
JOBPILOT_BASE_URL=https://YOUR_JOBPILOT_HOST

# Scanning is executed outside Render by GitHub Actions. The web service only queues work.
JOBPILOT_SCHEDULER_ENABLED=false
JOBPILOT_SCAN_EXECUTION_MODE=external
JOBPILOT_SCAN_HOUR=8
JOBPILOT_SCAN_MINUTE=0
JOBPILOT_TIMEZONE=Asia/Jerusalem
JOBPILOT_CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JOBPILOT_GITHUB_ACTIONS_TOKEN=github_pat_REPLACE_ME
JOBPILOT_GITHUB_REPOSITORY=almogkarif/JobPilot
JOBPILOT_GITHUB_SCAN_WORKFLOW=jobpilot-scan.yml
JOBPILOT_GITHUB_REF=main

# Render does not execute collectors. These values remain useful for local mode; the Actions worker sets its own bounded concurrency.
JOBPILOT_MAX_CONCURRENT_USER_SCANS=1
JOBPILOT_SCAN_CONCURRENCY=1
JOBPILOT_SOURCE_SCAN_TIMEOUT_SECONDS=45

# Legacy shared Agent tokens are intentionally disabled in cloud mode.
JOBPILOT_ALLOW_LEGACY_AGENT_TOKEN=false
