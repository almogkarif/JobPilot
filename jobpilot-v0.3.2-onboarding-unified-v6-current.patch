+
+
+/* Onboarding v6 — one visual language across the full first-run journey */
+.onboarding-step{position:relative;padding:8px 4px 4px}
+.onboarding-step:not(.onboarding-step-review):not(.onboarding-step-scan)>:is(.kicker,.onboarding-hero .kicker){display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;background:var(--brand-soft);color:var(--brand);font-weight:850}
+.onboarding-step:not(.onboarding-step-review):not(.onboarding-step-scan)>h1,.onboarding-step .onboarding-hero>h1{letter-spacing:-.025em}
+.onboarding-step-resume .onboarding-upload,.onboarding-step-skills .onboarding-skill-checks,.onboarding-step-preferences .onboarding-form,.onboarding-step-track .onboarding-track-grid{margin-top:22px}
+.onboarding-step-resume .onboarding-upload,.onboarding-step-preferences .onboarding-form>fieldset,.onboarding-step-preferences .onboarding-form>label,.onboarding-step-skills .onboarding-skill-check,.onboarding-step-track .onboarding-track-card{box-shadow:0 10px 30px rgba(25,65,95,.055)}
+.onboarding-step-preferences .onboarding-form>fieldset,.onboarding-step-preferences .onboarding-form>label{border-color:var(--line);background:linear-gradient(145deg,var(--panel),var(--panel-2));border-radius:20px}
+.onboarding-step-preferences fieldset>legend{padding-inline:7px;color:var(--text);font-weight:900}
+.onboarding-step-skills .onboarding-skill-checks{padding:16px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,var(--panel),var(--panel-2))}
+.onboarding-step-track .onboarding-track-card.active,.onboarding-step-skills .onboarding-skill-check.selected,.onboarding-step-preferences .onboarding-choice.selected{box-shadow:0 12px 30px var(--accent-glow)}
+.onboarding-step-scan .onboarding-scan-stage{max-width:900px;margin:auto;text-align:center}
+.onboarding-step-scan .onboarding-scan-stage>p{margin-inline:auto;text-align:center}
+.source-scan-progress.waiting>span b{font-size:17px;letter-spacing:4px;animation:onboardingWaitingPulse 1.15s ease-in-out infinite}
+.source-scan-progress.waiting>div i{width:28%!important;animation:onboardingWaitingBar 1.35s ease-in-out infinite}
+.source-scan-progress.waiting small{color:var(--brand);font-weight:800}
+@keyframes onboardingWaitingPulse{50%{opacity:.35}}
+@keyframes onboardingWaitingBar{0%{transform:translateX(260%)}50%{transform:translateX(0)}100%{transform:translateX(-260%)}}
+@media(max-width:700px){.onboarding-step{padding-inline:0}.onboarding-step-skills .onboarding-skill-checks{padding:10px}.onboarding-step-preferences .onboarding-form>fieldset,.onboarding-step-preferences .onboarding-form>label{border-radius:17px}}
+@media(prefers-reduced-motion:reduce){.source-scan-progress.waiting>span b,.source-scan-progress.waiting>div i{animation:none!important}}
