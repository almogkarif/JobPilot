+  .results-summary { grid-column:1 / -1; margin:0 2px 2px; font-size:9px; color:var(--muted); }
+  .jobs-grid { grid-template-columns:minmax(0,1fr) !important; gap:10px; }
+  .job-card { padding:13px; gap:10px; border-radius:19px; }
+  .job-card-head { gap:10px; align-items:flex-start; }
+  .job-card h3 { font-size:15px; line-height:1.35; }
+  .job-card .company { margin-top:3px; font-size:10px; }
+  .score-badge { min-width:48px; height:48px; display:grid; place-items:center; border-radius:15px; font-size:16px; flex:0 0 48px; }
+  .job-meta { display:flex; flex-wrap:wrap; gap:5px; }
+  .job-meta span { padding:5px 7px; border:1px solid var(--line); border-radius:999px; background:var(--surface-soft); font-size:8px; }
+  .skills { display:flex; flex-wrap:nowrap; overflow-x:auto; gap:5px; padding-bottom:2px; scrollbar-width:none; }
+  .skills::-webkit-scrollbar { display:none; }
+  .skills span { flex:0 0 auto; white-space:nowrap; }
+  .reason-list { display:flex; gap:5px; flex-wrap:wrap; }
+  .reason { font-size:8px; }
+  .job-card .card-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px; }
+  .job-card .card-actions > * { width:100%; min-width:0; min-height:38px; justify-content:center; }
+  .guest-job-actions { grid-template-columns:1fr 1fr !important; }
+  .jobs-pagination { gap:5px; padding:8px 0; overflow-x:auto; justify-content:flex-start; scrollbar-width:none; }
+  .jobs-pagination::-webkit-scrollbar { display:none; }
+
+  /* Forms and secondary screens: one clear reading column. */
+  .profile-section-nav { gap:6px; padding-bottom:3px; }
+  .profile-section-nav button { min-width:170px; flex-basis:170px; }
+  .form-grid,.automation-controls,.application-options { grid-template-columns:minmax(0,1fr) !important; }
+  .option-grid,.profile-pane[data-profile-pane="preferences"] .option-grid { grid-template-columns:minmax(0,1fr) !important; }
+  .table-wrap { overflow-x:auto; border-radius:16px; }
+  .application-automation-head,.panel-head { flex-wrap:wrap; }
+
+  /* Modals behave like native bottom sheets on phones. */
+  .modal { align-items:flex-end; justify-content:center; padding:0; }
+  .modal-card {
+    width:100%; max-width:none; max-height:92dvh; margin:0; padding:20px 16px calc(18px + var(--mobile-safe-bottom));
+    border-radius:24px 24px 0 0; transform:translateY(24px); overscroll-behavior:contain;
+  }
+  .modal.open .modal-card { transform:translateY(0); }
+  .modal-close { top:12px; left:12px; }
+
+  /* Login receives the same mobile hierarchy as the app itself. */
+  .auth-gate { padding:16px 12px calc(18px + env(safe-area-inset-bottom)); align-items:flex-start; }
+  .auth-shell { width:100%; max-width:520px; gap:12px; margin:0 auto; }
+  .auth-brand.brand { min-height:58px; justify-content:flex-start; }
+  .auth-brand .brand-mark { width:52px; height:52px; flex-basis:52px; }
+  .auth-brand strong { font-size:22px; }
+  .auth-card { width:100%; padding:18px 15px; border-radius:22px; }
+  .auth-heading h1 { font-size:22px; }
+  .auth-heading p { font-size:10px; line-height:1.5; }
+  .auth-google,.auth-submit,.auth-guest { min-height:50px; }
+  .auth-footnote { padding-inline:8px; font-size:8px; line-height:1.45; }
+
+  /* Fixed bottom navigation for thumb reach. */
+  .mobile-bottom-nav {
+    position:fixed; z-index:60; right:10px; left:10px; bottom:var(--mobile-safe-bottom); height:64px;
+    display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); align-items:center; gap:2px; padding:5px;
+    border:1px solid color-mix(in srgb,var(--line) 88%,transparent); border-radius:22px;
+    background:color-mix(in srgb,var(--panel) 94%,transparent); box-shadow:0 16px 42px rgba(10,42,65,.19); backdrop-filter:blur(22px);
+  }
+  .mobile-bottom-nav button {
+    min-width:0; height:54px; display:grid; place-items:center; align-content:center; gap:2px; padding:2px;
+    border:0; border-radius:17px; background:transparent; color:var(--muted); font:inherit;
+  }
+  .mobile-bottom-nav button > span { min-width:28px; height:28px; display:grid; place-items:center; border-radius:10px; font-size:17px; font-weight:850; }
+  .mobile-bottom-nav button small { font-size:8px; font-weight:780; }
+  .mobile-bottom-nav button.active { color:var(--brand); }
+  .mobile-bottom-nav button.active > span { background:var(--brand-soft); color:var(--brand); }
+
+  .mobile-nav-backdrop {
+    position:fixed; z-index:70; inset:0; display:flex; align-items:flex-end; justify-content:center; padding:0;
+    background:rgba(3,16,26,.38); opacity:0; visibility:hidden; pointer-events:none; transition:opacity .2s ease,visibility .2s ease;
+  }
+  .mobile-nav-backdrop.open { opacity:1; visibility:visible; pointer-events:auto; }
+  .mobile-nav-sheet {
+    width:100%; padding:8px 14px calc(18px + env(safe-area-inset-bottom)); border:1px solid var(--line); border-bottom:0;
+    border-radius:26px 26px 0 0; background:var(--panel); box-shadow:0 -18px 50px rgba(5,24,38,.2);
+    transform:translateY(22px); transition:transform .24s var(--ease-apple-out);
+  }
+  .mobile-nav-backdrop.open .mobile-nav-sheet { transform:translateY(0); }
+  .mobile-sheet-handle { width:44px; height:4px; margin:0 auto 10px; border-radius:999px; background:var(--line-strong); }
+  .mobile-sheet-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
+  .mobile-sheet-head h2 { margin:1px 0 0; font-size:18px; }
+  .mobile-sheet-head > button { width:36px; height:36px; border:1px solid var(--line); border-radius:12px; background:var(--surface-soft); color:var(--ink); font-size:20px; }
+  .mobile-menu-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
+  .mobile-menu-grid button { min-width:0; min-height:84px; display:grid; grid-template-columns:34px minmax(0,1fr); grid-template-rows:auto auto; column-gap:8px; align-items:center; padding:10px; text-align:right; border:1px solid var(--line); border-radius:17px; background:var(--surface-soft); color:var(--ink); font:inherit; }
+  .mobile-menu-grid button > span { grid-row:1 / span 2; width:34px; height:34px; display:grid; place-items:center; border-radius:11px; background:var(--brand-soft); color:var(--brand); font-weight:900; }
+  .mobile-menu-grid strong { font-size:10px; }
+  .mobile-menu-grid small { color:var(--muted); font-size:8px; line-height:1.35; }
+  .mobile-menu-grid button.active { border-color:color-mix(in srgb,var(--brand) 45%,var(--line)); background:color-mix(in srgb,var(--brand-soft) 62%,var(--panel)); }
+  .mobile-sheet-note { margin:10px 2px 0; color:var(--muted); font-size:8px; line-height:1.45; }
+  body.mobile-nav-open { overflow:hidden; }
+
+  .notification-center { position:fixed; right:10px; left:10px; bottom:calc(78px + var(--mobile-safe-bottom)); width:auto; max-height:65dvh; border-radius:20px; }
+}
+
+body.theme-dark .mobile-bottom-nav,body.theme-dark .mobile-nav-sheet { background:color-mix(in srgb,var(--panel) 95%,#071522); }
+body.track-industrial-engineering .mobile-bottom-nav button.active,body.track-industrial-engineering .mobile-menu-grid button > span { color:var(--accent); }
+body.track-industrial-engineering .mobile-bottom-nav button.active > span { background:var(--accent-soft); color:var(--accent); }
+body.track-industrial-engineering .mobile-menu-grid button.active { border-color:var(--accent-border); background:var(--accent-soft-2); }
+
+/* Shared admin catalog has no guest-owned application status to filter by. */
+body.guest-mode .job-status-control { display:none !important; }
