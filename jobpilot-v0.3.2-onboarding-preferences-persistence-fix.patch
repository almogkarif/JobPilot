diff --git a/mnt/data/jp_onboarding_persist_work/tests/test_onboarding_persistence_contract.py b/tests/test_onboarding_persistence_contract.py
new file mode 100644
index 0000000..274b783
--- /dev/null
+++ b/tests/test_onboarding_persistence_contract.py
@@ -0,0 +1,13 @@
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+JS=(ROOT/'app/static/app.js').read_text()
+
+def test_onboarding_rehydrates_persisted_profile_every_time_it_opens():
+    block=JS[JS.index('async function openOnboarding'):JS.index('async function maybeOpenOnboarding')]
+    assert "state.profile=await api('/api/profile')" in block
+    assert "onboardingState.selectedSkills=new Set(state.profile?.skills||[])" in block
+
+def test_reselecting_active_track_refreshes_persisted_preferences():
+    block=JS[JS.index('async function onboardingChooseTrack'):JS.index('function onboardingSetStep')]
+    assert "state.profile=await api('/api/profile')" in block
+    assert "onboardingState.selectedSkills=new Set(state.profile?.skills||[])" in block
