+  main { padding-bottom:var(--mobile-dock-clearance) !important; }
+
+  /* The dock lives outside .sidebar so backdrop-filter/sticky ancestors cannot
+     turn position:fixed into a top-anchored containing block on mobile browsers. */
+  #mobile-tab-dock.mobile-tab-dock {
+    position:fixed !important;
+    z-index:78 !important;
+    top:auto !important;
+    right:10px !important;
+    left:10px !important;
+    bottom:calc(10px + env(safe-area-inset-bottom)) !important;
+    width:auto !important;
