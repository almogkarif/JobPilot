# Local mode (default). Cloud values live in .env.cloud.example.
JOBPILOT_AUTH_MODE=local
JOBPILOT_STORAGE_MODE=local
JOBPILOT_DATABASE_URL=sqlite:///./data/jobpilot.db
JOBPILOT_BASE_URL=http://127.0.0.1:8000
JOBPILOT_AGENT_TOKEN=change-me
JOBPILOT_SCAN_HOUR=8
JOBPILOT_SCAN_MINUTE=0
JOBPILOT_TIMEZONE=Asia/Jerusalem
JOBPILOT_AGENT_ID=my-mac
JOBPILOT_AGENT_HEADLESS=false
JOBPILOT_WORKER_TYPE=local
JOBPILOT_TASK_TIMEOUT_SECONDS=180
JOBPILOT_AUTO_SUBMIT=false

JOBPILOT_SCAN_CONCURRENCY=4
JOBPILOT_SOURCE_SCAN_TIMEOUT_SECONDS=45

JOBPILOT_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_RANDOM_SECRET
# Optional Gmail receipt verification (Google OAuth Web application)
JOBPILOT_GOOGLE_OAUTH_CLIENT_ID=
JOBPILOT_GOOGLE_OAUTH_CLIENT_SECRET=
JOBPILOT_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gmail/callback
