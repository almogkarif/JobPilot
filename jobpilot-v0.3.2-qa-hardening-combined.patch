+            except (zipfile.BadZipFile, OSError):
+                valid = False
+    elif suffix == ".txt":
+        if b"\x00" not in content:
+            try:
+                content.decode("utf-8-sig")
+                valid = True
+            except UnicodeDecodeError:
+                valid = False
+    if not valid:
+        raise HTTPException(400, "Resume content does not match its file type")
