+/* v0.3.2 — Palette Redesign V2
+   Same JobPilot visual hierarchy, lighter career identities.
+   IE&M = ivory / sand / champagne with restrained amber.
+   Electrical = white / true silver / cool graphite with dusty-pink actions. */
+body.track-industrial-engineering {
+  --bg:#fbfaf6; --panel:#fffefb; --ink:#342f25; --text:#342f25; --muted:#766f62;
+  --line:#e8e1d3; --line-strong:#d8ccb7; --surface-soft:#faf7f0; --surface-tint:#f5eedf;
+  --panel-2:#fcf8ef; --brand:#a97824; --brand2:#d8b66d; --brand-soft:#f8edcf;
+  --accent-border:#dfc993; --accent-glow:rgba(169,120,36,.105); --accent-glow-strong:rgba(169,120,36,.18);
+  --focus-ring:0 0 0 4px rgba(190,151,78,.14);
+  --shadow:0 14px 40px rgba(72,58,31,.065); --shadow-soft:0 8px 24px rgba(72,58,31,.05);
+  background:linear-gradient(135deg,#fffefa 0%,#faf6ed 58%,#f3ead8 100%);color:var(--ink);
+}
+body.track-industrial-engineering.theme-dark {
+  --bg:#181713; --panel:#22201b; --ink:#f4efe5; --text:#f4efe5; --muted:#b8ae9b;
+  --line:#454036; --line-strong:#5d5546; --surface-soft:#1d1c18; --surface-tint:#2c2922;
+  --panel-2:#29261f; --brand:#d7b46d; --brand2:#ead39e; --brand-soft:#393226;
+  --accent-border:#756348; --accent-glow:rgba(215,180,109,.12); --accent-glow-strong:rgba(215,180,109,.2);
+  --focus-ring:0 0 0 4px rgba(215,180,109,.14);
+  --shadow:0 16px 44px rgba(0,0,0,.26); --shadow-soft:0 8px 24px rgba(0,0,0,.18);
+  background:linear-gradient(135deg,#151410 0%,#201e19 58%,#29251d 100%);color:var(--ink);
+}
+body.track-electrical-engineering {
+  --bg:#f8f9fa; --panel:#fff; --ink:#333238; --text:#333238; --muted:#73727a;
+  --line:#e0e1e5; --line-strong:#c9cbd1; --surface-soft:#f7f7f9; --surface-tint:#eff0f3;
+  --panel-2:#fafafb; --brand:#b95c88; --brand2:#d998b8; --brand-soft:#f8eaf1;
+  --accent-border:#dcb8ca; --accent-glow:rgba(185,92,136,.105); --accent-glow-strong:rgba(185,92,136,.18);
+  --silver:#b9bcc4; --silver-strong:#8f929b; --silver-soft:#f0f1f3; --silver-panel:#f7f7f8;
+  --focus-ring:0 0 0 4px rgba(185,92,136,.13);
+  --shadow:0 14px 40px rgba(65,65,74,.065); --shadow-soft:0 8px 24px rgba(65,65,74,.05);
+  background:linear-gradient(135deg,#fff 0%,#f4f5f7 52%,#f9edf3 100%);color:var(--ink);
+}
+body.track-electrical-engineering.theme-dark {
+  --bg:#17171a; --panel:#202024; --ink:#f3f3f5; --text:#f3f3f5; --muted:#b1b1b8;
+  --line:#414148; --line-strong:#595a63; --surface-soft:#1c1c20; --surface-tint:#2a2a30;
+  --panel-2:#26262b; --brand:#d58aaa; --brand2:#e6b2c9; --brand-soft:#382a31;
+  --accent-border:#6e4d5d; --accent-glow:rgba(213,138,170,.12); --accent-glow-strong:rgba(213,138,170,.2);
+  --silver:#aeb0b8; --silver-strong:#d1d2d7; --silver-soft:#2b2c31; --silver-panel:#24252a;
+  --focus-ring:0 0 0 4px rgba(213,138,170,.14);
+  --shadow:0 16px 44px rgba(0,0,0,.28); --shadow-soft:0 8px 24px rgba(0,0,0,.2);
+  background:linear-gradient(135deg,#151518 0%,#222228 58%,#2a2227 100%);color:var(--ink);
+}
+
+/* Keep saturated career color for actions; make the rest calm and material-like. */
+body:is(.track-industrial-engineering,.track-electrical-engineering) :where(.panel,.toolbar,.metric,.job-row,.job-card,.source-item,.blocker-card,.profile-detail-section,.preference-group,.answer-card,.notification-item,.onboarding-shell){box-shadow:var(--shadow-soft)!important}
+body:is(.track-industrial-engineering,.track-electrical-engineering) :where(.option-grid label:has(input:checked),.check-row label:has(input:checked),.answer-enabled:has(input:checked),.onboarding-choice.selected,.onboarding-skill-check.selected){box-shadow:0 5px 14px var(--accent-glow)!important}
+body:is(.track-industrial-engineering,.track-electrical-engineering) .btn.primary{box-shadow:0 8px 20px var(--accent-glow-strong)!important}
+
+/* Electrical: silver is a real secondary material, not a hidden token. */
+body.track-electrical-engineering :where(.sidebar nav::before,.profile-section-nav,.theme-switch,.career-switcher-trigger,.jobs-toolbar,.filter-control,.job-search-field){background:linear-gradient(145deg,var(--panel),var(--silver-soft))!important;border-color:var(--line-strong)!important}
+body.track-electrical-engineering :where(.sidebar nav button .nav-icon,.icon-action,.section-collapse,.career-option-symbol,.ready-facts article>span,.ready-next-icon){background:linear-gradient(145deg,#fff,var(--silver-soft))!important;border-color:var(--silver)!important;color:var(--silver-strong)!important}
+body.track-electrical-engineering :where(.table-wrap th,.kanban-column,.score-breakdown,.source-health i,.profile-completion-track){background:var(--silver-soft)!important}
+body.track-electrical-engineering :where(.panel,.metric,.job-row,.job-card,.source-item,.profile-detail-section,.preference-group,.answer-card){border-color:color-mix(in srgb,var(--silver) 62%,white)!important}
+body.track-electrical-engineering .logo-surface{fill:#8f667a!important;stroke:#c9cbd1!important}
+body.track-electrical-engineering .logo-grid{stroke:#c9cbd1!important}
+body.track-electrical-engineering .logo-route-depth{stroke:#666770!important}
+body.track-electrical-engineering .logo-route{stroke:#e5b4ca!important}
+body.track-electrical-engineering.theme-dark :where(.sidebar nav button .nav-icon,.icon-action,.section-collapse,.career-option-symbol,.ready-facts article>span,.ready-next-icon){background:linear-gradient(145deg,var(--panel),var(--silver-soft))!important;border-color:#55565f!important;color:var(--silver-strong)!important}
+body.track-electrical-engineering.theme-dark :where(.sidebar nav::before,.profile-section-nav,.theme-switch,.career-switcher-trigger,.jobs-toolbar,.filter-control,.job-search-field){background:linear-gradient(145deg,var(--panel),var(--silver-panel))!important;border-color:#4b4c54!important}
+body.track-electrical-engineering.theme-dark :where(.panel,.metric,.job-row,.job-card,.source-item,.profile-detail-section,.preference-group,.answer-card){border-color:#414148!important}
+
+/* Active/selected states stay unmistakably career-colored on top of the quieter material palette. */
+body.track-electrical-engineering :where(.sidebar nav button:hover .nav-icon,.sidebar nav button:focus-visible .nav-icon,.sidebar nav button.active .nav-icon,.profile-section-nav button.active>span){background:linear-gradient(155deg,var(--brand2),var(--brand))!important;border-color:var(--brand)!important;color:#fff!important}
+body.track-industrial-engineering :where(.sidebar nav button:hover .nav-icon,.sidebar nav button:focus-visible .nav-icon,.sidebar nav button.active .nav-icon,.profile-section-nav button.active>span){background:linear-gradient(155deg,var(--brand2),var(--brand))!important;border-color:var(--brand)!important;color:#fff!important}
+
+/* Mobile and onboarding inherit the exact same palette rather than a separate skin. */
+@media(max-width:820px){
+  body.track-industrial-engineering #mobile-tab-dock.mobile-tab-dock,
+  body.track-electrical-engineering #mobile-tab-dock.mobile-tab-dock{background:color-mix(in srgb,var(--panel) 96%,var(--surface-tint))!important;border-color:var(--line)!important;box-shadow:0 12px 34px var(--shadow-soft)!important}
+  body:is(.track-industrial-engineering,.track-electrical-engineering) #mobile-tab-dock.mobile-tab-dock>button{color:var(--muted)!important}
+  body:is(.track-industrial-engineering,.track-electrical-engineering) #mobile-tab-dock.mobile-tab-dock>button.active{background:var(--brand-soft)!important;color:var(--brand)!important}
+}
